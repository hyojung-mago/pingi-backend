# Server
PORT=8000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pingi?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=500000

# CORS
CORS_ORIGIN=http://localhost:5173,,http://localhost:9603,https://pingi.app,

# Frontend URL (for share links)
FRONTEND_URL=https://pingi.app
