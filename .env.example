# ============================================================
# Pingi Backend 환경 변수
# 이 파일을 .env로 복사한 뒤 실제 값을 채워 사용하세요.
#   cp .env.example .env
# ============================================================

# Server
PORT=8000
NODE_ENV=development

# Database (PostgreSQL)
# 로컬 네이티브 실행: localhost:5432
# Docker 실행:       pingi-postgres:5432 (docker-compose 서비스명)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pingi?schema=public

# Docker Compose용 Postgres 설정 (docker-compose.db.yml에서 참조)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=pingi

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS (콤마 구분으로 여러 origin 지정 가능)
CORS_ORIGIN=http://localhost:5173,http://localhost:9603,https://pingi.mago52.com

# Frontend URL (공유 링크 생성에 사용)
FRONTEND_URL=https://pingi.app

# Pingi-AI Service
# 로컬 네이티브 실행: http://localhost:8001
# Docker 실행:       http://pingi-ai:8001 (docker-compose 서비스명)
AI_API_URL=http://localhost:8001

# Google Cloud — 귀가 후기 서버 STT (선택)
# 서비스 계정 JSON 경로. Cloud Speech-to-Text API 사용 설정 필요.
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
